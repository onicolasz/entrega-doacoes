{
  "name": "entrega-doacoes",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @entrega/api --filter @entrega/mobile dev",
    "dev:api": "pnpm --filter @entrega/api dev",
    "dev:mobile": "pnpm --filter @entrega/mobile dev",
    "build": "pnpm --filter @entrega/contracts build && pnpm --filter @entrega/api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @entrega/api test",
    "db:migrate": "pnpm --filter @entrega/api db:migrate",
    "db:seed": "pnpm --filter @entrega/api db:seed",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "postinstall": "pnpm --filter @entrega/contracts build && pnpm --filter @entrega/api db:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.56.0",
    "@eslint/js": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1"
  }
}
